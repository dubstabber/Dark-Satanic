{
  "dirs": [
    "res://tests/unit/",
    "res://tests/integration/",
    "res://tests/e2e/"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "should_exit": true,
  "should_exit_on_success": false,
  "ignore_pause": true,
  "log_level": 1,
  "double_strategy": "SCRIPT_ONLY",
  "hide_orphans": false,
  "compact_mode": true,
  "disable_colors": false,
  "junit_xml_file": "",
  "junit_xml_timestamp": false,
  "failure_error_types": ["engine", "gut", "push_error"]
}
