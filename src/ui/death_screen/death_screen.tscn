; Full-rect margin + a centring HBox instead of a CenterContainer: a CenterContainer
; hands its child the child's minimum size, so a ten-row board pushed the buttons off
; the bottom of the screen. Here the column fills the height and BoardFrame is the only
; thing that expands, which pins RETRY / MENU to the bottom whatever the board does.
[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
alignment = 1

[node name="Column" type="VBoxContainer" parent="Margin/Row"]
custom_minimum_size = Vector2(660, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Margin/Row/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "REQUIESCAT"
label_settings = ExtResource("4_title")
horizontal_alignment = 1

