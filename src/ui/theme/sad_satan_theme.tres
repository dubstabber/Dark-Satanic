variation_transform = Transform2D(1, 0, -0.14, 1, 0, 0)
spacing_glyph = 2
spacing_space = 3

; The frame texture is a 96 px 9-slice with 32 px corners, so its painted bar reaches
; well inside the box. Content margins have to clear that or the first and last rows of
; a scrolling board sit under the ornament.
